OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.5
AI_REQUEST_TIMEOUT=30
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_RETRIES=2
# Fail-closed deployment gate. Production also requires every protection value below.
PUBLIC_ASSISTANT_CHAT_ENABLED=false
PUBLIC_CHAT_ALLOWED_ORIGINS=http://localhost:5173
# Must exactly match Uvicorn's trusted proxy setting in production.
PUBLIC_CHAT_TRUSTED_PROXIES=127.0.0.1/32
FORWARDED_ALLOW_IPS=127.0.0.1/32
# Use a unique random value of at least 32 characters in each production environment.
PUBLIC_CHAT_CLIENT_KEY_HASH_SECRET=development-only-public-chat-key
PUBLIC_CHAT_RETRIEVAL_LIMIT=3
PUBLIC_CHAT_MIN_SIMILARITY_SCORE=0.7
PUBLIC_CHAT_MAX_MESSAGE_CHARACTERS=4000
PUBLIC_CHAT_MAX_HISTORY_MESSAGE_CHARACTERS=4000
PUBLIC_CHAT_MAX_HISTORY_MESSAGES=12
PUBLIC_CHAT_MAX_HISTORY_CHARACTERS=12000
PUBLIC_CHAT_MAX_HISTORY_TOKENS=12000
PUBLIC_CHAT_MAX_REQUEST_BYTES=32768
PUBLIC_CHAT_MAX_INPUT_TOKENS=8000
PUBLIC_CHAT_MAX_CONTEXT_CHUNKS=3
PUBLIC_CHAT_MAX_CONTEXT_TOKENS=4000
PUBLIC_CHAT_MODEL_CONTEXT_TOKENS=1050000
PUBLIC_CHAT_MAX_OUTPUT_TOKENS=500
PUBLIC_CHAT_MAX_ESTIMATED_COST=0.10
PUBLIC_CHAT_TEMPERATURE=0.2
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=10
PUBLIC_CHAT_RATE_LIMIT_PER_HOUR=100
PUBLIC_CHAT_GLOBAL_RATE_LIMIT_PER_MINUTE=300
PUBLIC_CHAT_MAX_CONCURRENT_REQUESTS_PER_CLIENT=2
PUBLIC_CHAT_MAX_CONCURRENT_REQUESTS_GLOBAL=20
PUBLIC_CHAT_REQUEST_TIMEOUT_SECONDS=45
PUBLIC_CHAT_MODEL_FIRST_TOKEN_TIMEOUT_SECONDS=15
EMBEDDING_BATCH_SIZE=100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_engineer
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_OPERATION_TIMEOUT_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=2
REDIS_URL=redis://localhost:6379/0
DISABLE_CACHE=false
DEBUG_DELAY=false
DISABLE_INGEST=false
DISABLE_AUDIT_LOGS=false
DISABLE_RATE_LIMITS=false
INGEST_API_KEY=
ADMIN_API_KEY=
# Configure both only to create the first administrator; existing credentials are preserved.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_COOKIE_NAME=redmoor_admin_session
# Set false explicitly for local HTTP only. Production must remain true.
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_SESSION_COOKIE_SAMESITE=lax
ADMIN_TRUSTED_ORIGINS=http://localhost:5173,https://app.redmoorconsulting.co.uk
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_LOGIN_THROTTLE_WINDOW_SECONDS=60
ADMIN_LOGIN_THROTTLE_IP_ATTEMPTS=20
ADMIN_LOGIN_THROTTLE_EMAIL_ATTEMPTS=10
ADMIN_LOGIN_THROTTLE_GLOBAL_ATTEMPTS=200
# Server-managed evaluation resources; clients never supply these paths.
EVALUATION_DATASET_DIR=examples/evaluation
EVALUATION_REPORT_DIR=evaluation-reports
MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads
INGESTION_TIMEOUT_SECONDS=10
INGESTION_HTTP_RETRIES=2
INGESTION_RETRY_MAX_ATTEMPTS=3
INGESTION_RETRY_INITIAL_DELAY_SECONDS=1
INGESTION_RETRY_BACKOFF_MULTIPLIER=2
INGESTION_RETRY_MAX_DELAY_SECONDS=30
INGESTION_RETRY_JITTER_ENABLED=true
INGESTION_WORKER_ENABLED=true
INGESTION_WORKER_POLL_INTERVAL_SECONDS=1
INGESTION_WORKER_LEASE_SECONDS=60
INGESTION_WORKER_HEARTBEAT_INTERVAL_SECONDS=20
INGESTION_WORKER_CONCURRENCY=1
INGESTION_WORKER_SHUTDOWN_GRACE_SECONDS=30
# INGESTION_WORKER_ID=optional-stable-instance-name
INGESTION_MAX_PAGES=25
INGESTION_USER_AGENT=AI-Discovery-Assistant/1.0
INGESTION_MAX_RESPONSE_SIZE=5242880
INGESTION_CHUNK_SIZE_CHARACTERS=1200
INGESTION_CHUNK_OVERLAP_CHARACTERS=150
INGESTION_MIN_CHUNK_SIZE_CHARACTERS=100
INGESTION_MIN_DOCUMENT_LENGTH_CHARACTERS=50
APP_ENV=development
