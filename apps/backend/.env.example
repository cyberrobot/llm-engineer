OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.5
AI_REQUEST_TIMEOUT=30
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_engineer
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_OPERATION_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
DISABLE_CACHE=false
DEBUG_DELAY=false
DISABLE_INGEST=false
DISABLE_AUDIT_LOGS=false
DISABLE_RATE_LIMITS=false
INGEST_API_KEY=
ADMIN_API_KEY=
MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads
INGESTION_TIMEOUT_SECONDS=10
INGESTION_HTTP_RETRIES=2
INGESTION_RETRY_MAX_ATTEMPTS=3
INGESTION_RETRY_INITIAL_DELAY_SECONDS=1
INGESTION_RETRY_BACKOFF_MULTIPLIER=2
INGESTION_RETRY_MAX_DELAY_SECONDS=30
INGESTION_RETRY_JITTER_ENABLED=true
INGESTION_MAX_PAGES=25
INGESTION_USER_AGENT=AI-Discovery-Assistant/1.0
INGESTION_MAX_RESPONSE_SIZE=5242880
INGESTION_CHUNK_SIZE_CHARACTERS=1200
INGESTION_CHUNK_OVERLAP_CHARACTERS=150
INGESTION_MIN_CHUNK_SIZE_CHARACTERS=100
INGESTION_MIN_DOCUMENT_LENGTH_CHARACTERS=50
APP_ENV=development
